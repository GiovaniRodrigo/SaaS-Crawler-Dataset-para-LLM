{
  "manifest_version": 3,
  "name": "LLM Dataset Crawler Extension",
  "version": "1.0",
  "description": "Capture web pages for your LLM dataset.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": ["http://localhost/*"]
}
